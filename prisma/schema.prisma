generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuizSession {
  id                   String    @id @default(cuid())
  county               String
  town                 String
  senateDist           Int
  houseDist            String
  answers              Json      // QuizAnswer[]
  results              Json?     // MatchResult[]
  straightLineDetected Boolean   @default(false)
  nudgeShown           Boolean   @default(false)
  retakeChosen         Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([county])
  @@index([senateDist])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String?
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([sessionId])
  @@index([createdAt])
}
